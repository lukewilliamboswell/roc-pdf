      "snapshot": "tests/gate1_retention/snapshot.pdf",
      "args": ["32"],
      "measurement_boundary": "before_fixture_main",
      "dimensions": { "pages": 1, "backing_bytes": 8192, "resource_bytes": 64 },
      "work_counters": ["buffered_bytes", "shared_bytes", "owned_bytes", "shared_ranges", "owned_ranges", "shared_copied_bytes", "owned_copied_bytes", "resource_bytes"],
