{
  "schema_version": 2,
  "protocol_version": 1,
  "toolchain": {
    "roc_optimization": "speed",
    "zig_version": "0.16.0",
    "zig_optimization": "ReleaseFast"
  },
  "cases": [
    {
      "name": "Gate 1 blank PDF",
      "scenario_revision": "gate1-blank-v1",
      "source": "tests/gate1_blank/main.roc",
      "snapshot": "tests/gate1_blank/snapshot.pdf",
      "args": [],
      "measurement_boundary": "before_fixture_main",
      "dimensions": { "pages": 1 },
      "work_counters": ["passes", "byte_visits"],
      "expectations": {
        "arm64mac": { "allocations": 0, "work": [1, 667] },
        "x64musl": { "allocations": 0, "work": [1, 667] }
      }
    },
    {
      "name": "Gate 1 balanced 4096-page PDF",
      "scenario_revision": "gate1-pages-v1",
      "source": "tests/gate1_pages/main.roc",
      "snapshot": "tests/gate1_pages/snapshot.pdf",
      "args": ["stress"],
      "measurement_boundary": "before_fixture_main",
      "dimensions": { "pages": 4096 },
      "work_counters": ["pages", "tree_nodes", "objects", "values", "array_edges", "dictionary_edges", "build_edges", "references", "byte_visits"],
      "expectations": {
        "arm64mac": { "allocations": 113794, "work": [4096, 133, 12422, 17186, 4232, 21013, 25245, 8585, 1084927] },
        "x64musl": { "allocations": 113794, "work": [4096, 133, 12422, 17186, 4232, 21013, 25245, 8585, 1084927] }
      }
    },
    {
      "name": "placeholder PDF x1",
      "scenario_revision": "placeholder-v1",
      "source": "tests/placeholder/main.roc",
      "snapshot": "tests/placeholder/snapshot.pdf",
      "args": [],
      "measurement_boundary": "before_fixture_main",
      "dimensions": { "passes": 1 },
      "work_counters": ["passes", "byte_visits"],
      "expectations": {
        "arm64mac": { "allocations": 1, "work": [1, 431] },
        "x64musl": { "allocations": 1, "work": [1, 431] }
      }
    },
    {
      "name": "placeholder PDF x4",
      "scenario_revision": "placeholder-v1",
      "source": "tests/placeholder/main.roc",
      "snapshot": "tests/placeholder/snapshot.pdf",
      "args": ["scale"],
      "measurement_boundary": "before_fixture_main",
      "dimensions": { "passes": 4 },
      "work_counters": ["passes", "byte_visits"],
