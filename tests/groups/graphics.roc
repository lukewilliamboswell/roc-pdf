app [main!] {
	color_images: "../color_images/package.roc",
	pf: platform "../platform/main.roc",
	shading_patterns: "../shading_patterns/package.roc",
	soft_masks: "../soft_masks/package.roc",
	transparency: "../transparency/package.roc",
}

import pf.Metrics
import color_images.Cases as ColorImages
import shading_patterns.Cases as ShadingPatterns
import soft_masks.Cases as SoftMasks
import transparency.Cases as Transparency

## Fixture group `graphics`: one executable for these case families.
## Generated by scripts/fixture_groups.py from tests/spec.json; do not edit.
Case : [
	ColorImages(ColorImages.Case),
	ShadingPatterns(ShadingPatterns.Case),
	SoftMasks(SoftMasks.Case),
	Transparency(Transparency.Case),
]

CaseSpec : { case : Case, schema_version : U64 }

main! : List(Str) => { bytes : List(U8), work : List(U64) }
main! = |args| {
	case_json = match args.get(1) {
		Ok(text) => text
		Err(OutOfBounds) => crash "CASE_SPEC_MISSING: graphics requires exactly one JSON case argument"
	}
	if args.len() != 2 {
		crash "CASE_SPEC_ARITY: graphics requires exactly one JSON case argument"
	}
	parsed : Try(CaseSpec, [InvalidJson(Str), MissingRequiredField(Str)])
	parsed = Json.parse(case_json)
	spec = match parsed {
		Ok(value) => value
		Err(InvalidJson(detail)) => crash "CASE_SPEC_INVALID_JSON: ${detail}"
		Err(MissingRequiredField(field)) => crash "CASE_SPEC_MISSING_FIELD: ${field}"
	}
	if spec.schema_version != 2 {
		crash "CASE_SPEC_UNSUPPORTED_VERSION: graphics supports schema_version 2"
	}
	if Json.to_str(spec) != case_json {
		crash "CASE_SPEC_NON_CANONICAL: graphics rejects unknown fields and non-canonical JSON"
	}
	Metrics.reset_allocations!()
	match spec.case {
		ColorImages(case) => ColorImages.run(case)
		ShadingPatterns(case) => ShadingPatterns.run(case)
		SoftMasks(case) => SoftMasks.run(case)
		Transparency(case) => Transparency.run(case)
	}
}
