app [main!] {
	containers: "../containers/package.roc",
	pf: platform "../platform/main.roc",
	reference_layout: "../reference_layout/package.roc",
	resource_graph: "../resource_graph/package.roc",
	source_text: "../source_text/package.roc",
	structural_kernel: "../structural_kernel/package.roc",
	unicode_vectors: "../unicode_vectors/package.roc",
}

import pf.Metrics
import containers.Cases as Containers
import reference_layout.Cases as ReferenceLayout
import resource_graph.Cases as ResourceGraph
import source_text.Cases as SourceText
import structural_kernel.Cases as StructuralKernel
import unicode_vectors.Cases as UnicodeVectors

## Fixture group `kernel`: one executable for these case families.
## Generated by scripts/fixture_groups.py from tests/spec.json; do not edit.
Case : [
	Containers(Containers.Case),
	ReferenceLayout(ReferenceLayout.Case),
	ResourceGraph(ResourceGraph.Case),
	SourceText(SourceText.Case),
	StructuralKernel(StructuralKernel.Case),
	UnicodeVectors(UnicodeVectors.Case),
]

CaseSpec : { case : Case, schema_version : U64 }

main! : List(Str) => { bytes : List(U8), work : List(U64) }
main! = |args| {
	case_json = match args.get(1) {
		Ok(text) => text
		Err(OutOfBounds) => crash "CASE_SPEC_MISSING: kernel requires exactly one JSON case argument"
	}
	if args.len() != 2 {
		crash "CASE_SPEC_ARITY: kernel requires exactly one JSON case argument"
	}
	parsed : Try(CaseSpec, [InvalidJson(Str), MissingRequiredField(Str)])
	parsed = Json.parse(case_json)
	spec = match parsed {
		Ok(value) => value
		Err(InvalidJson(detail)) => crash "CASE_SPEC_INVALID_JSON: ${detail}"
		Err(MissingRequiredField(field)) => crash "CASE_SPEC_MISSING_FIELD: ${field}"
	}
	if spec.schema_version != 2 {
		crash "CASE_SPEC_UNSUPPORTED_VERSION: kernel supports schema_version 2"
	}
	if Json.to_str(spec) != case_json {
		crash "CASE_SPEC_NON_CANONICAL: kernel rejects unknown fields and non-canonical JSON"
	}
	Metrics.reset_allocations!()
	match spec.case {
		Containers(case) => Containers.run(case)
		ReferenceLayout(case) => ReferenceLayout.run(case)
		ResourceGraph(case) => ResourceGraph.run(case)
		SourceText(case) => SourceText.run(case)
		StructuralKernel(case) => StructuralKernel.run(case)
		UnicodeVectors(case) => UnicodeVectors.run(case)
	}
}
