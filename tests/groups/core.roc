app [main!] {
	authoring: "../authoring/package.roc",
	bidi: "../bidi/package.roc",
	caller_font: "../caller_font/package.roc",
	color_images: "../color_images/package.roc",
	facade_fragments: "../facade_fragments/package.roc",
	facade_scenes: "../facade_scenes/package.roc",
	facade_text: "../facade_text/package.roc",
	font: "../font/package.roc",
	font_leaves: "../font_leaves/package.roc",
	font_subsetting: "../font_subsetting/package.roc",
	form_text: "../form_text/package.roc",
	generated_label: "../generated_label/package.roc",
	pdf_font: "../pdf_font/package.roc",
	pf: platform "../platform/main.roc",
	placeholder: "../placeholder/package.roc",
	shading_patterns: "../shading_patterns/package.roc",
	shaping: "../shaping/package.roc",
	soft_masks: "../soft_masks/package.roc",
	tagged_visual: "../tagged_visual/package.roc",
	transparency: "../transparency/package.roc",
	unicode_analysis: "../unicode_analysis/package.roc",
	visible_text: "../visible_text/package.roc",
}

import pf.Metrics
import authoring.Cases as Authoring
import bidi.Cases as Bidi
import caller_font.Cases as CallerFont
import color_images.Cases as ColorImages
import facade_fragments.Cases as FacadeFragments
import facade_scenes.Cases as FacadeScenes
import facade_text.Cases as FacadeText
import font.Cases as Font
import font_leaves.Cases as FontLeaves
import font_subsetting.Cases as FontSubsetting
import form_text.Cases as FormText
import generated_label.Cases as GeneratedLabel
import pdf_font.Cases as PdfFont
import placeholder.Cases as Placeholder
import shading_patterns.Cases as ShadingPatterns
import shaping.Cases as Shaping
import soft_masks.Cases as SoftMasks
import tagged_visual.Cases as TaggedVisual
import transparency.Cases as Transparency
import unicode_analysis.Cases as UnicodeAnalysis
import visible_text.Cases as VisibleText

## Fixture group `core`: one executable for these case families.
## Generated by scripts/fixture_groups.py from tests/spec.json; do not edit.
Case : [
	Authoring(Authoring.Case),
	Bidi(Bidi.Case),
	CallerFont(CallerFont.Case),
	ColorImages(ColorImages.Case),
	FacadeFragments(FacadeFragments.Case),
	FacadeScenes(FacadeScenes.Case),
	FacadeText(FacadeText.Case),
	Font(Font.Case),
	FontLeaves(FontLeaves.Case),
	FontSubsetting(FontSubsetting.Case),
	FormText(FormText.Case),
	GeneratedLabel(GeneratedLabel.Case),
	PdfFont(PdfFont.Case),
	Placeholder(Placeholder.Case),
	ShadingPatterns(ShadingPatterns.Case),
	Shaping(Shaping.Case),
	SoftMasks(SoftMasks.Case),
	TaggedVisual(TaggedVisual.Case),
	Transparency(Transparency.Case),
	UnicodeAnalysis(UnicodeAnalysis.Case),
	VisibleText(VisibleText.Case),
]

CaseSpec : { case : Case, schema_version : U64 }

main! : List(Str) => { bytes : List(U8), work : List(U64) }
main! = |args| {
	case_json = match args.get(1) {
		Ok(text) => text
		Err(OutOfBounds) => crash "CASE_SPEC_MISSING: core requires exactly one JSON case argument"
	}
	if args.len() != 2 {
		crash "CASE_SPEC_ARITY: core requires exactly one JSON case argument"
	}
	parsed : Try(CaseSpec, [InvalidJson(Str), MissingRequiredField(Str)])
	parsed = Json.parse(case_json)
	spec = match parsed {
		Ok(value) => value
		Err(InvalidJson(detail)) => crash "CASE_SPEC_INVALID_JSON: ${detail}"
		Err(MissingRequiredField(field)) => crash "CASE_SPEC_MISSING_FIELD: ${field}"
	}
	if spec.schema_version != 2 {
		crash "CASE_SPEC_UNSUPPORTED_VERSION: core supports schema_version 2"
	}
	if Json.to_str(spec) != case_json {
		crash "CASE_SPEC_NON_CANONICAL: core rejects unknown fields and non-canonical JSON"
	}
	Metrics.reset_allocations!()
	match spec.case {
		Authoring(case) => Authoring.run(case)
		Bidi(case) => Bidi.run(case)
		CallerFont(case) => CallerFont.run(case)
		ColorImages(case) => ColorImages.run(case)
		FacadeFragments(case) => FacadeFragments.run(case)
		FacadeScenes(case) => FacadeScenes.run(case)
		FacadeText(case) => FacadeText.run(case)
		Font(case) => Font.run(case)
		FontLeaves(case) => FontLeaves.run(case)
		FontSubsetting(case) => FontSubsetting.run(case)
		FormText(case) => FormText.run(case)
		GeneratedLabel(case) => GeneratedLabel.run(case)
		PdfFont(case) => PdfFont.run(case)
		Placeholder(case) => Placeholder.run(case)
		ShadingPatterns(case) => ShadingPatterns.run(case)
		Shaping(case) => Shaping.run(case)
		SoftMasks(case) => SoftMasks.run(case)
		TaggedVisual(case) => TaggedVisual.run(case)
		Transparency(case) => Transparency.run(case)
		UnicodeAnalysis(case) => UnicodeAnalysis.run(case)
		VisibleText(case) => VisibleText.run(case)
	}
}
