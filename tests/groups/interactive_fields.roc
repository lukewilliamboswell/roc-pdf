app [main!] {
	interactive_fields: "../interactive_fields/package.roc",
	pf: platform "../platform/main.roc",
}

import pf.Metrics
import interactive_fields.Cases as InteractiveFields

## Fixture group `interactive_fields`: one executable for these case families.
## Generated by scripts/fixture_groups.py from tests/spec.json; do not edit.
Case : [
	InteractiveFields(InteractiveFields.Case),
]

CaseSpec : { case : Case, schema_version : U64 }

main! : List(Str) => { bytes : List(U8), work : List(U64) }
main! = |args| {
	case_json = match args.get(1) {
		Ok(text) => text
		Err(OutOfBounds) => crash "CASE_SPEC_MISSING: interactive_fields requires exactly one JSON case argument"
	}
	if args.len() != 2 {
		crash "CASE_SPEC_ARITY: interactive_fields requires exactly one JSON case argument"
	}
	parsed : Try(CaseSpec, [InvalidJson(Str), MissingRequiredField(Str)])
	parsed = Json.parse(case_json)
	spec = match parsed {
		Ok(value) => value
		Err(InvalidJson(detail)) => crash "CASE_SPEC_INVALID_JSON: ${detail}"
		Err(MissingRequiredField(field)) => crash "CASE_SPEC_MISSING_FIELD: ${field}"
	}
	if spec.schema_version != 2 {
		crash "CASE_SPEC_UNSUPPORTED_VERSION: interactive_fields supports schema_version 2"
	}
	if Json.to_str(spec) != case_json {
		crash "CASE_SPEC_NON_CANONICAL: interactive_fields rejects unknown fields and non-canonical JSON"
	}
	Metrics.reset_allocations!()
	match spec.case {
		InteractiveFields(case) => InteractiveFields.run(case)
	}
}
