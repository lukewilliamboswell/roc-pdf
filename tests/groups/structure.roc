app [main!] {
	actual_text: "../actual_text/package.roc",
	facade_output: "../facade_output/package.roc",
	navigation: "../navigation/package.roc",
	pf: platform "../platform/main.roc",
}

import pf.Metrics
import actual_text.Cases as ActualText
import facade_output.Cases as FacadeOutput
import navigation.Cases as Navigation

## Fixture group `structure`: one executable for these case families.
## Generated by scripts/fixture_groups.py from tests/spec.json; do not edit.
Case : [
	ActualText(ActualText.Case),
	FacadeOutput(FacadeOutput.Case),
	Navigation(Navigation.Case),
]

CaseSpec : { case : Case, schema_version : U64 }

main! : List(Str) => { bytes : List(U8), work : List(U64) }
main! = |args| {
	case_json = match args.get(1) {
		Ok(text) => text
		Err(OutOfBounds) => crash "CASE_SPEC_MISSING: structure requires exactly one JSON case argument"
	}
	if args.len() != 2 {
		crash "CASE_SPEC_ARITY: structure requires exactly one JSON case argument"
	}
	parsed : Try(CaseSpec, [InvalidJson(Str), MissingRequiredField(Str)])
	parsed = Json.parse(case_json)
	spec = match parsed {
		Ok(value) => value
		Err(InvalidJson(detail)) => crash "CASE_SPEC_INVALID_JSON: ${detail}"
		Err(MissingRequiredField(field)) => crash "CASE_SPEC_MISSING_FIELD: ${field}"
	}
	if spec.schema_version != 2 {
		crash "CASE_SPEC_UNSUPPORTED_VERSION: structure supports schema_version 2"
	}
	if Json.to_str(spec) != case_json {
		crash "CASE_SPEC_NON_CANONICAL: structure rejects unknown fields and non-canonical JSON"
	}
	Metrics.reset_allocations!()
	match spec.case {
		ActualText(case) => ActualText.run(case)
		FacadeOutput(case) => FacadeOutput.run(case)
		Navigation(case) => Navigation.run(case)
	}
}
