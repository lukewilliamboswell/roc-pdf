app [main!] {
	pf: platform "../platform/main.roc",
	rich_inline: "../rich_inline/package.roc",
	source_blocks: "../source_blocks/package.roc",
}

import pf.Metrics
import rich_inline.Cases as RichInline
import source_blocks.Cases as SourceBlocks

## Fixture group `text`: one executable for these case families.
## Generated by scripts/fixture_groups.py from tests/spec.json; do not edit.
Case : [
	RichInline(RichInline.Case),
	SourceBlocks(SourceBlocks.Case),
]

CaseSpec : { case : Case, schema_version : U64 }

main! : List(Str) => { bytes : List(U8), work : List(U64) }
main! = |args| {
	case_json = match args.get(1) {
		Ok(text) => text
		Err(OutOfBounds) => crash "CASE_SPEC_MISSING: text requires exactly one JSON case argument"
	}
	if args.len() != 2 {
		crash "CASE_SPEC_ARITY: text requires exactly one JSON case argument"
	}
	parsed : Try(CaseSpec, [InvalidJson(Str), MissingRequiredField(Str)])
	parsed = Json.parse(case_json)
	spec = match parsed {
		Ok(value) => value
		Err(InvalidJson(detail)) => crash "CASE_SPEC_INVALID_JSON: ${detail}"
		Err(MissingRequiredField(field)) => crash "CASE_SPEC_MISSING_FIELD: ${field}"
	}
	if spec.schema_version != 2 {
		crash "CASE_SPEC_UNSUPPORTED_VERSION: text supports schema_version 2"
	}
	if Json.to_str(spec) != case_json {
		crash "CASE_SPEC_NON_CANONICAL: text rejects unknown fields and non-canonical JSON"
	}
	Metrics.reset_allocations!()
	match spec.case {
		RichInline(case) => RichInline.run(case)
		SourceBlocks(case) => SourceBlocks.run(case)
	}
}
