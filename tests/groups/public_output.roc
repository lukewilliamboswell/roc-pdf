app [main!] {
	metadata_facade: "../metadata_facade/package.roc",
	navigation_facade: "../navigation_facade/package.roc",
	pdf_facade: "../pdf_facade/package.roc",
	pf: platform "../platform/main.roc",
}

import pf.Metrics
import metadata_facade.Cases as MetadataFacade
import navigation_facade.Cases as NavigationFacade
import pdf_facade.Cases as PdfFacade

## Fixture group `public_output`: one executable for these case families.
## Generated by scripts/fixture_groups.py from tests/spec.json; do not edit.
Case : [
	MetadataFacade(MetadataFacade.Case),
	NavigationFacade(NavigationFacade.Case),
	PdfFacade(PdfFacade.Case),
]

CaseSpec : { case : Case, schema_version : U64 }

main! : List(Str) => { bytes : List(U8), work : List(U64) }
main! = |args| {
	case_json = match args.get(1) {
		Ok(text) => text
		Err(OutOfBounds) => crash "CASE_SPEC_MISSING: public_output requires exactly one JSON case argument"
	}
	if args.len() != 2 {
		crash "CASE_SPEC_ARITY: public_output requires exactly one JSON case argument"
	}
	parsed : Try(CaseSpec, [InvalidJson(Str), MissingRequiredField(Str)])
	parsed = Json.parse(case_json)
	spec = match parsed {
		Ok(value) => value
		Err(InvalidJson(detail)) => crash "CASE_SPEC_INVALID_JSON: ${detail}"
		Err(MissingRequiredField(field)) => crash "CASE_SPEC_MISSING_FIELD: ${field}"
	}
	if spec.schema_version != 2 {
		crash "CASE_SPEC_UNSUPPORTED_VERSION: public_output supports schema_version 2"
	}
	if Json.to_str(spec) != case_json {
		crash "CASE_SPEC_NON_CANONICAL: public_output rejects unknown fields and non-canonical JSON"
	}
	Metrics.reset_allocations!()
	match spec.case {
		MetadataFacade(case) => MetadataFacade.run(case)
		NavigationFacade(case) => NavigationFacade.run(case)
		PdfFacade(case) => PdfFacade.run(case)
	}
}
