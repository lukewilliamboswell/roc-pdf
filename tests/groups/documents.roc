app [main!] {
	pf: platform "../platform/main.roc",
	reference_documents: "../reference_documents/package.roc",
	rich_flow: "../rich_flow/package.roc",
	technical_manual: "../technical_manual/package.roc",
}

import pf.Metrics
import reference_documents.Cases as ReferenceDocuments
import rich_flow.Cases as RichFlow
import technical_manual.Cases as TechnicalManual

## Fixture group `documents`: one executable for these case families.
## Generated by scripts/fixture_groups.py from tests/spec.json; do not edit.
Case : [
	ReferenceDocuments(ReferenceDocuments.Case),
	RichFlow(RichFlow.Case),
	TechnicalManual(TechnicalManual.Case),
]

CaseSpec : { case : Case, schema_version : U64 }

main! : List(Str) => { bytes : List(U8), work : List(U64) }
main! = |args| {
	case_json = match args.get(1) {
		Ok(text) => text
		Err(OutOfBounds) => crash "CASE_SPEC_MISSING: documents requires exactly one JSON case argument"
	}
	if args.len() != 2 {
		crash "CASE_SPEC_ARITY: documents requires exactly one JSON case argument"
	}
	parsed : Try(CaseSpec, [InvalidJson(Str), MissingRequiredField(Str)])
	parsed = Json.parse(case_json)
	spec = match parsed {
		Ok(value) => value
		Err(InvalidJson(detail)) => crash "CASE_SPEC_INVALID_JSON: ${detail}"
		Err(MissingRequiredField(field)) => crash "CASE_SPEC_MISSING_FIELD: ${field}"
	}
	if spec.schema_version != 2 {
		crash "CASE_SPEC_UNSUPPORTED_VERSION: documents supports schema_version 2"
	}
	if Json.to_str(spec) != case_json {
		crash "CASE_SPEC_NON_CANONICAL: documents rejects unknown fields and non-canonical JSON"
	}
	Metrics.reset_allocations!()
	match spec.case {
		ReferenceDocuments(case) => ReferenceDocuments.run(case)
		RichFlow(case) => RichFlow.run(case)
		TechnicalManual(case) => TechnicalManual.run(case)
	}
}
